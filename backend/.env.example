# Copy to backend/.env. Never commit real keys.
APP_MODE=local
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
UPLOADS_ENABLED=true
DELETES_ENABLED=true
# Optional shared demo passphrase, entered by visitors. Not a model/database key.
DEMO_ACCESS_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=
ANSWER_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
STORAGE_BUCKET=research-pdfs
MAX_FILE_MB=10
MAX_DOCUMENTS=30
MAX_PAGES=150
REQUESTS_PER_MINUTE=60
QUESTIONS_PER_MINUTE=10
UPLOADS_PER_HOUR=10
SIMILARITY_THRESHOLD=0.3
LOCAL_DATA_DIR=.local-data
